# Tandoor connection
TANDOOR_BASE_URL=https://recipes.example.com
TANDOOR_AUTH_TOKEN=replace-me
TANDOOR_USERNAME=admin
TANDOOR_PASSWORD=replace-me

# ChatGPT secure tunnel
CONTROL_PLANE_TUNNEL_ID=tunnel_replace_me
OPENAI_API_KEY=sk-replace-me

# Optional New Relic tracing. Use an Ingest License key; a blank key disables
# all OTLP export.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=tandoor-mcp
NEW_RELIC_OTLP_ENDPOINT=https://otlp.nr-data.net:4318

# Private S3 thumbnail cache (dummy credentials)
S3_BUCKET=tandoor-mcp-thumbnails
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=AKIAEXAMPLEDUMMYKEY0
S3_SECRET_ACCESS_KEY=dummySecretKeyReplaceMe0000000000000000
S3_FORCE_PATH_STYLE=false
S3_THUMBNAIL_PREFIX=thumbnails/
S3_PUBLIC_BASE_URL=
THUMBNAIL_URL_TTL_SECS=86400
THUMBNAIL_MAX_EDGE=512
